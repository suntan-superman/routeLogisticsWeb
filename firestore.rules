rules_version = '2';

// Single source of truth for Firestore security. Deploy with `firebase deploy --only firestore`.
// Tenancy model:
//  - Solo/legacy docs: owned by `userId` and have no `companyId`.
//  - Company docs: carry `companyId`; access comes from the `companyId` and `role`
//    custom claims, which are minted only by the `syncClaims` Cloud Function.
// Clients can never write `role`, `companyId` claims, or change `companyId` on data docs.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.get('portal', false) != true;
    }
    function uid() {
      return request.auth.uid;
    }
    function claimCompany() {
      return request.auth.token.get('companyId', null);
    }
    function claimRole() {
      return request.auth.token.get('role', null);
    }
    function isManager() {
      return claimRole() in ['owner', 'admin', 'manager'];
    }
    function isFinance() { return claimRole() in ['owner', 'admin']; }
    function isStaff() {
      return claimRole() in ['owner', 'admin', 'manager', 'technician'];
    }
    function activeCompanyAccess() {
      return request.auth.token.get('email_verified', false) == true && ((claimRole() == 'owner'
          && get(/databases/$(database)/documents/companies/$(claimCompany())).data.ownerId == uid())
        || (claimRole() in ['admin', 'manager', 'technician']
          && request.auth.token.get('membershipId', null) != null
          && get(/databases/$(database)/documents/teamMembers/$(request.auth.token.membershipId)).data.uid == uid()
          && get(/databases/$(database)/documents/teamMembers/$(request.auth.token.membershipId)).data.companyId == claimCompany()
          && get(/databases/$(database)/documents/teamMembers/$(request.auth.token.membershipId)).data.status == 'active'
          && get(/databases/$(database)/documents/teamMembers/$(request.auth.token.membershipId)).data.role == claimRole()));
    }

    // Data doc helpers (d = resource.data or request.resource.data)
    function isSolo(d) {
      return d.get('companyId', null) == null && d.get('userId', null) == uid()
        && claimCompany() == null
        && get(/databases/$(database)/documents/users/$(uid())).data.get('rlCompanyId', null) == null;
    }
    function inCompany(d) {
      return signedIn() && claimCompany() != null && d.get('companyId', null) == claimCompany() && activeCompanyAccess();
    }
    function readable(d) {
      return signedIn() && (isSolo(d) || (inCompany(d) && isManager()));
    }
    // Raw documents can contain financial/history fields. Other roles use allowlisted callables.
    function financeAccess(d) { return signedIn() && (isSolo(d) || (inCompany(d) && isFinance())); }
    function jobAccess(d) {
      return d.get('jobId', null) != null
        && get(/databases/$(database)/documents/jobs/$(d.jobId)).data.get('companyId', null) == d.get('companyId', null)
        && (manageable(d) || (inCompany(d) && claimRole() == 'technician'
          && get(/databases/$(database)/documents/jobs/$(d.jobId)).data.assignedTo == request.auth.token.membershipId));
    }
    function manageable(d) {
      return signedIn() && (isSolo(d) || (inCompany(d) && isManager()));
    }
    // Ownership and tenancy fields may not be changed by clients.
    function tenancyUnchanged() {
      return request.resource.data.get('userId', null) == resource.data.get('userId', null)
        && request.resource.data.get('companyId', null) == resource.data.get('companyId', null);
    }
    // New docs must be attributed to the caller and, if tenant-scoped, to the caller's company.
    function validCreate(allowTechnician) {
      return signedIn()
        && request.resource.data.get('userId', null) == uid()
        && ((request.resource.data.get('companyId', null) == null && claimCompany() == null
              && get(/databases/$(database)/documents/users/$(uid())).data.get('rlCompanyId', null) == null)
            || (inCompany(request.resource.data)
                && (isManager() || (allowTechnician && isStaff()))));
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
        && request.resource.data.get('role', null) == null
        && request.resource.data.get('rlCompanyId', null) == null
        && request.resource.data.get('legacyBackfilledAt', null) == null
        && request.resource.data.get('companyId', null) == null;
      // role/legacy flags are server-managed; companyId may only point at a company the user owns.
      allow update: if signedIn() && uid() == userId
        && request.resource.data.get('rlCompanyId', null) == resource.data.get('rlCompanyId', null)
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('legacyBackfilledAt', null) == resource.data.get('legacyBackfilledAt', null)
        && (request.resource.data.get('companyId', null) == resource.data.get('companyId', null)
            || (request.resource.data.get('companyId', null) != null
                && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId == uid()));
      allow delete: if false;
    }

    // ---------- companies ----------
    match /companies/{companyId} {
      allow read: if signedIn()
        && request.auth.token.get('email_verified', false) == true
        && (resource.data.ownerId == uid() || (claimCompany() == companyId && activeCompanyAccess() && isFinance()));
      allow create: if false; // rlCreateCompany checks actual ownership and all invitation/membership states.
      allow update: if signedIn()
        && request.auth.token.get('email_verified', false) == true
        && resource.data.ownerId == uid()
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    // ---------- team members ----------
    // Invites are created by the owner; activation (setting `uid`) happens only in Cloud Functions.
    match /teamMembers/{teamMemberId} {
      allow read: if signedIn()
        && request.auth.token.get('email_verified', false) == true
        && (get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.ownerId == uid()
            || resource.data.get('uid', null) == uid()
            || (inCompany(resource.data) && isManager()));
      allow create, update: if false; // Owner-authorized callables validate roles and invitation lifecycle.
      allow delete: if false; // Audited removal is performed by manageTeamMember.
    }

    // ---------- customers ----------
    match /customers/{id} {
      allow read: if financeAccess(resource.data);
      allow create: if validCreate(false) && (financeAccess(request.resource.data)
        || (request.resource.data.get('totalSpent', 0) == 0
          && !request.resource.data.keys().hasAny(['balance', 'revenue', 'paymentStatus', 'invoiceBalance', 'quickbooksId', 'quickbooksCustomerId'])));
      allow update: if manageable(resource.data) && tenancyUnchanged()
        && (financeAccess(resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalSpent', 'balance', 'revenue', 'paymentStatus', 'invoiceBalance', 'quickbooksId', 'quickbooksCustomerId']));
      allow delete: if financeAccess(resource.data);
    }

    // ---------- jobs ----------
    match /jobs/{id} {
      function validStatus(s) {
        return s in ['scheduled', 'en-route', 'in-progress', 'completed', 'cancelled'];
      }
      function technicianFields() {
        return ['status', 'notes', 'completedAt', 'actualWorkDone', 'actualHours',
                'completionNotes', 'cancelledAt', 'cancellationReason', 'updatedAt'];
      }
      function statusOk() {
        return !('status' in request.resource.data)
          || (validStatus(request.resource.data.status)
              && (request.resource.data.status == resource.data.get('status', request.resource.data.status)
                  || !(resource.data.get('status', 'scheduled') in ['completed', 'cancelled'])
                  || isManager() || isSolo(resource.data)));
      }

      allow read: if financeAccess(resource.data);
      allow create: if validCreate(false) && (claimCompany() == null || isFinance())
        && validStatus(request.resource.data.get('status', 'scheduled'));
      allow update: if tenancyUnchanged() && statusOk()
        && financeAccess(resource.data);
      allow delete: if financeAccess(resource.data); // Managers use rlManageJob; technicians use rlApplyJobOperation.
    }

    // ---------- appointments ----------
    match /appointments/{id} {
      allow read: if financeAccess(resource.data);
      allow create: if validCreate(false);
      allow update: if manageable(resource.data) && tenancyUnchanged();
      allow delete: if manageable(resource.data);
    }

    // ---------- photos (technicians may add proof-of-service photos) ----------
    match /photos/{id} {
      allow read: if financeAccess(resource.data);
      allow create: if false; // Authenticated photo callable prevents permanent download-token URLs.
      allow update, delete: if false; // The photo callable validates job assignment and the storage path.
    }

    // ---------- estimates ----------
    match /estimates/{id} {
      allow read: if readable(resource.data)
        && (resource.data.get('rlManaged', false) != true || manageable(resource.data));
      // Versioned Route Logistics estimates are written only through the callable.
      // Legacy estimate documents retain their existing permissions.
      allow create: if validCreate(false) && request.resource.data.get('rlManaged', false) != true;
      allow update: if manageable(resource.data) && tenancyUnchanged()
        && resource.data.get('rlManaged', false) != true
        && request.resource.data.get('rlManaged', false) != true;
      allow delete: if manageable(resource.data) && resource.data.get('rlManaged', false) != true;
    }

    // ---------- estimate templates ----------
    match /estimateTemplates/{id} {
      allow read: if readable(resource.data);
      allow create: if validCreate(false);
      allow update: if manageable(resource.data) && tenancyUnchanged();
      allow delete: if manageable(resource.data);
    }

    // ---------- invoices ----------
    // Paid invoices are immutable (void by issuing a new document); only drafts may be deleted.
    match /invoices/{id} {
      function validInvoiceStatus(s) {
        return s in ['draft', 'sent', 'paid', 'void'];
      }
      function paymentFields() {
        return ['paymentLock', 'paymentStatus', 'paymentIntentId', 'amountRefunded', 'paymentUpdatedAt', 'testPaymentStatus', 'testPaymentUpdatedAt', 'qbTestPaymentStatus', 'qbBalance', 'qbPaymentReview', 'qbReconciledAt', 'paidVia'];
      }
      allow read: if financeAccess(resource.data);
      allow create: if validCreate(false) && (claimCompany() == null || isFinance())
        && !request.resource.data.keys().hasAny(paymentFields())
        && validInvoiceStatus(request.resource.data.get('status', 'draft'))
        && request.resource.data.get('total', 0) is number
        && request.resource.data.get('total', 0) >= 0;
      allow update: if financeAccess(resource.data) && tenancyUnchanged()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(paymentFields())
        && (resource.data.get('paymentLock', null) == null
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total', 'currency', 'customerId', 'status', 'lineItems', 'subtotal', 'tax', 'taxRate']))
        && resource.data.get('status', 'draft') != 'paid'
        && validInvoiceStatus(request.resource.data.get('status', 'draft'))
        && request.resource.data.get('total', 0) is number && request.resource.data.get('total', 0) >= 0;
      allow delete: if financeAccess(resource.data) && resource.data.get('status', 'draft') == 'draft';
    }

    // ---------- recurring service plans ----------
    match /servicePlans/{id} {
      allow read: if readable(resource.data);
      allow create: if validCreate(false)
        && request.resource.data.get('frequencyDays', 0) is number
        && request.resource.data.get('frequencyDays', 0) > 0;
      allow update: if manageable(resource.data) && tenancyUnchanged();
      allow delete: if manageable(resource.data);
    }

    // ---------- service / chemical application logs ----------
    // Regulatory records: technicians may add them, but nobody may delete them from the client.
    match /serviceLogs/{id} {
      allow read: if readable(resource.data);
      allow create: if validCreate(false) && jobAccess(request.resource.data);
      allow update: if manageable(resource.data) && tenancyUnchanged();
      allow delete: if false;
    }

    // ---------- push notification device tokens (read by Cloud Functions via the Admin SDK) ----------
    match /deviceTokens/{id} {
      allow read, delete: if signedIn() && resource.data.get('userId', null) == uid();
      allow create: if signedIn()
        && request.resource.data.get('userId', null) == uid()
        && request.resource.data.get('token', null) is string
        && id == uid() + '_' + request.resource.data.token;
      allow update: if signedIn()
        && resource.data.get('userId', null) == uid()
        && request.resource.data.get('userId', null) == uid()
        && request.resource.data.get('token', null) == resource.data.get('token', null);
    }

    match /rlNotifications/{id} {
      allow read: if signedIn() && resource.data.userId == uid()
        && (resource.data.get('companyId', null) == null || inCompany(resource.data));
      allow update: if signedIn() && resource.data.userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
