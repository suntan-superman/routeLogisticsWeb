[
  {
    "id": "pest-control",
    "name": "Pest control inspection",
    "industry": "pest",
    "version": 1,
    "status": "starter",
    "description": "Inspection and visit findings. Chemical application records remain separate.",
    "fields": [
      {
        "id": "targetPest",
        "label": "Target pest",
        "type": "select",
        "required": true,
        "options": [
          "Ants",
          "Cockroaches",
          "Rodents",
          "Termites",
          "Other"
        ]
      },
      {
        "id": "findings",
        "label": "Inspection findings",
        "type": "text",
        "required": true,
        "maxLength": 4000
      },
      {
        "id": "inspection",
        "label": "Inspection completed",
        "type": "checklist",
        "required": true,
        "options": [
          "Entry points inspected",
          "Activity inspected",
          "Conditions documented",
          "Customer instructions provided"
        ]
      },
      {
        "id": "followUp",
        "label": "Follow-up recommendation",
        "type": "text"
      },
      {
        "id": "photos",
        "label": "Visit photos",
        "type": "photos",
        "maxPhotos": 8
      },
      {
        "id": "technicianNotes",
        "label": "Technician notes",
        "type": "notes",
        "maxLength": 4000
      }
    ]
  },
