rules_version = '2';

// Paths: users/{uid}/** for solo users, companies/{companyId}/** for company members
// (company membership comes from the `companyId` custom claim minted by the syncClaims function).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.get('portal', false) != true;
    }
    function validUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isManagerRole() {
      return request.auth.token.get('role', null) in ['owner', 'admin', 'manager'];
    }
    function activeCompany(companyId) {
      return signedIn() && request.auth.token.get('companyId', null) == companyId
        && request.auth.token.get('email_verified', false) == true
        && (firestore.get(/databases/(default)/documents/companies/$(companyId)).data.ownerId == request.auth.uid
          || (request.auth.token.get('membershipId', null) != null
            && firestore.get(/databases/(default)/documents/teamMembers/$(request.auth.token.membershipId)).data.uid == request.auth.uid
            && firestore.get(/databases/(default)/documents/teamMembers/$(request.auth.token.membershipId)).data.companyId == companyId
            && firestore.get(/databases/(default)/documents/teamMembers/$(request.auth.token.membershipId)).data.status == 'active'
            && firestore.get(/databases/(default)/documents/teamMembers/$(request.auth.token.membershipId)).data.role == request.auth.token.get('role', null)));
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == userId && request.auth.token.get('companyId', null) == null
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.get('rlCompanyId', null) == null;
      allow create, update: if signedIn() && request.auth.uid == userId && request.auth.token.get('companyId', null) == null
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.get('rlCompanyId', null) == null && validUpload();
      allow delete: if signedIn() && request.auth.uid == userId && request.auth.token.get('companyId', null) == null
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.get('rlCompanyId', null) == null;
    }

    match /companies/{companyId}/{allPaths=**} {
      allow read: if activeCompany(companyId) && request.auth.token.role in ['owner', 'admin'];
      allow create, update: if activeCompany(companyId) && request.auth.token.role in ['owner', 'admin'] && validUpload();
      allow delete: if activeCompany(companyId) && request.auth.token.role in ['owner', 'admin'];
    }

    // rlJobPhotos objects have no public download tokens. All reads/uploads pass
    // through rlJobPhoto, which rechecks live membership, job assignment and scope.
    match /rlJobPhotos/{allPaths=**} { allow read, write: if false; }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
