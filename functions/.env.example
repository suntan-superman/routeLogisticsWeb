# Non-secret deployment parameters. Use the actual application's canonical origin.
RL_APP_URL=https://route-logistics.com
RL_EMAIL_FROM=your-verified-sender@example.com
RL_EMAIL_ENABLED=false
RL_STRIPE_ENABLED=false
RL_STRIPE_MODE=test
RL_STRIPE_LIVE_APPROVED=false
RL_QB_ENABLED=false
RL_QB_ENV=sandbox
RL_QB_WRITES_ENABLED=false
RL_QB_REDIRECT_URI=https://us-central1-mi-factotum-field-service.cloudfunctions.net/rlQuickBooksOAuthCallback
# Secret Manager: RL_QB_CLIENT_ID, RL_QB_CLIENT_SECRET, RL_QB_WEBHOOK_VERIFIER
# Stripe secrets: RL_STRIPE_SECRET_KEY and RL_STRIPE_WEBHOOK_SECRET in Secret Manager.
# Store RL_SMTP_URL in Firebase Secret Manager, never in this file.

# Commercial readiness. Provider delivery is deliberately disabled initially.
RL_NATIVE_PUSH_ENABLED=false
RL_EXPO_ACCESS_TOKEN_ENABLED=false
# Optional Secret Manager credential: RL_EXPO_ACCESS_TOKEN (worker only).
RL_SMS_ENABLED=false
RL_SMS_LIVE_APPROVED=false
RL_SMS_SECRETS_CONFIGURED=false
# Secret Manager: RL_TWILIO_ACCOUNT_SID, RL_TWILIO_AUTH_TOKEN,
# RL_TWILIO_MESSAGING_SERVICE_SID. Keep bindings for STOP/status after activation.
RL_QB_PRODUCTION_APPROVED=false
RL_SERVICE_FORMS_ENABLED=false
RL_ESTIMATES_ENABLED=false
RL_ESTIMATE_EMAIL_ENABLED=false
# The existing SendGrid RL_EMAIL_ENABLED + RL_SMTP_URL are also required to email estimates.
