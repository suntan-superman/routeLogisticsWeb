# Optional Firebase JS client overrides. The checked-in defaults already target
# mi-factotum-field-service; a new Mac checkout does not require a .env file.
# Leave the key blank to retain the existing public Firebase-generated client key.
# To override it, copy ONLY the Firebase web-app client API key from that project.
# EXPO_PUBLIC_ values are embedded in the app. Never put Admin/service-account,
# SMTP, Stripe secret, or private signing credentials here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mi-factotum-field-service.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mi-factotum-field-service
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=mi-factotum-field-service.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1030013411579
EXPO_PUBLIC_FIREBASE_APP_ID=1:1030013411579:web:37cdb1ce1e57c1e75c505e
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-VS61WKSG39
