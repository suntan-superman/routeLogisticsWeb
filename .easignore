# EAS reads this repository-root file instead of all .gitignore files.
# Run EAS in routeLogisticsMobile; normal Git discovery uploads this parent tree.
# Keep all shared mobile helpers while excluding unrelated applications/docs/server code.
/routeLogisticsWeb/
/docs/
/scripts/
/tests/
/.github/
/functions/*
